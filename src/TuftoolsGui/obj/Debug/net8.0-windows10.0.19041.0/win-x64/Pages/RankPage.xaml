<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="TuftoolsGui.Pages.RankPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:TuftoolsGui.Models">
  <Page.Resources>
    <Style x:Key="CompactItemStyle" TargetType="ListViewItem">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </Page.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="24" Spacing="16">
      <TextBlock Text="排位预览" Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="把一份候选成绩换进玩家的前 20 成绩后，重新计算排位分并对比全球与国家名次。名次变化为负数表示前进。" Style="{StaticResource HintStyle}" />
      <InfoBar x:ConnectionId='2' x:Name="StatusBar" IsOpen="False" IsClosable="True" />
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="输入" Style="{StaticResource SectionTitleStyle}" />
          <Grid ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" Text="玩家" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:ConnectionId='9' Grid.Column="1" Grid.Row="0" x:Name="PlayerKeyBox" PlaceholderText="玩家 ID 或名称" />
            <TextBlock Grid.Column="2" Grid.Row="0" Text="定位方式" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox x:ConnectionId='10' Grid.Column="3" Grid.Row="0" x:Name="PlayerBy" SelectedIndex="0" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="按 ID" />
              <ComboBoxItem Content="按名称" />
              <ComboBoxItem Content="按 Discord" />
            </ComboBox>
            <TextBlock Grid.Column="0" Grid.Row="1" Text="候选分数" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:ConnectionId='11' Grid.Column="1" Grid.Row="1" x:Name="ScoreBox" PlaceholderText="例如 3305" />
            <TextBlock Grid.Column="2" Grid.Row="1" Text="替换谱面" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:ConnectionId='12' Grid.Column="3" Grid.Row="1" x:Name="LevelIdBox" PlaceholderText="可选：该成绩替换此谱面的旧记录" />
            <StackPanel Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <Button x:ConnectionId='13' Content="预览" Style="{StaticResource AccentButtonStyle}"                       />
              <ProgressRing x:ConnectionId='14' x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="结果" Style="{StaticResource SectionTitleStyle}" />
          <TextBlock x:ConnectionId='3' x:Name="SummaryText" Text="尚未预览。" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="22" />
          <ScrollViewer Height="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:ConnectionId='4' x:Name="ResultRows">
              <ItemsControl.ItemTemplate>
                <DataTemplate                                >
                  <Grid x:ConnectionId='6' ColumnSpacing="8" Padding="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="260" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:ConnectionId='7' Grid.Column="0"                     Style="{StaticResource CellStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:ConnectionId='8' Grid.Column="1"                       FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>

