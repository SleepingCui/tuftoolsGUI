<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="TuftoolsGui.Pages.PlayerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:TuftoolsGui.Models">
  <Page.Resources>
    <Style x:Key="CompactItemStyle" TargetType="ListViewItem">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </Page.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="24" Spacing="16">
      <TextBlock Text="玩家查询" Style="{StaticResource PageTitleStyle}" />
      <InfoBar x:ConnectionId='2' x:Name="StatusBar" IsOpen="False" IsClosable="True" />
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="搜索玩家" Style="{StaticResource SectionTitleStyle}" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:ConnectionId='39' Grid.Column="0" x:Name="PlayerQuery" PlaceholderText="玩家 ID、名称或 Discord 用户名"                               />
            <ComboBox x:ConnectionId='40' Grid.Column="1" x:Name="SearchBy" SelectedIndex="0" MinWidth="110">
              <ComboBoxItem Content="按名称或 ID" />
              <ComboBoxItem Content="按 Discord" />
            </ComboBox>
            <Button x:ConnectionId='41' Grid.Column="2" Content="搜索" Style="{StaticResource AccentButtonStyle}"                      />
            <ProgressRing x:ConnectionId='42' Grid.Column="3" x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
          </Grid>
          <TextBlock Text="搜索结果（单击一行查看详情）" Style="{StaticResource HintStyle}" />
          <Grid ColumnSpacing="8" Padding="8,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="60" />
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ID" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="1" Text="名称" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="2" Text="国家" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="3" Text="排位分" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="4" Text="平均准确率" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="5" Text="Discord" Style="{StaticResource TableHeaderStyle}" />
          </Grid>
          <ListView x:ConnectionId='30' x:Name="PlayerResults" Height="200" ItemContainerStyle="{StaticResource CompactItemStyle}" IsItemClickEnabled="True"                                     SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate                              >
                <Grid x:ConnectionId='32' ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="140" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:ConnectionId='33' Grid.Column="0"                    Style="{StaticResource CellStyle}" />
                  <TextBlock x:ConnectionId='34' Grid.Column="1"                      Style="{StaticResource CellStyle}" />
                  <TextBlock x:ConnectionId='35' Grid.Column="2"                         Style="{StaticResource CellStyle}" />
                  <TextBlock x:ConnectionId='36' Grid.Column="3"                        Style="{StaticResource CellStyle}" />
                  <TextBlock x:ConnectionId='37' Grid.Column="4"                          Style="{StaticResource CellStyle}" />
                  <TextBlock x:ConnectionId='38' Grid.Column="5"                         Style="{StaticResource CellStyle}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="玩家详情" Style="{StaticResource SectionTitleStyle}" />
          <TextBlock x:ConnectionId='15' x:Name="PlayerEmpty" Text="尚未选择玩家。" Style="{StaticResource HintStyle}" />
          <StackPanel x:ConnectionId='16' x:Name="PlayerDetailPanel" Spacing="12" Visibility="Collapsed">
            <StackPanel Spacing="2">
              <TextBlock x:ConnectionId='28' x:Name="PlayerTitle" FontSize="20" FontWeight="SemiBold" />
              <TextBlock x:ConnectionId='29' x:Name="PlayerMeta" Style="{StaticResource HintStyle}" />
            </StackPanel>
            <Grid ColumnSpacing="8" Padding="8,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="指标" Style="{StaticResource TableHeaderStyle}" />
              <TextBlock Grid.Column="1" Text="分数" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="2" Text="全球名次" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="3" Text="国家名次" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
            </Grid>
            <ItemsControl x:ConnectionId='17' x:Name="ScoreRows">
              <ItemsControl.ItemTemplate>
                <DataTemplate                             >
                  <Grid x:ConnectionId='23' ColumnSpacing="8" Padding="8,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="140" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:ConnectionId='24' Grid.Column="0"                       Style="{StaticResource CellStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:ConnectionId='25' Grid.Column="1"                       Style="{StaticResource CellStyle}" HorizontalAlignment="Right" />
                    <TextBlock x:ConnectionId='26' Grid.Column="2"                        Style="{StaticResource CellStyle}" HorizontalAlignment="Right" />
                    <TextBlock x:ConnectionId='27' Grid.Column="3"                         Style="{StaticResource CellStyle}" HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="通关总数" Style="{StaticResource HintStyle}" />
                <TextBlock x:ConnectionId='21' x:Name="StatPasses" FontSize="16" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="万能通关" Style="{StaticResource HintStyle}" />
                <TextBlock x:ConnectionId='20' x:Name="StatUniversal" FontSize="16" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Text="首通" Style="{StaticResource HintStyle}" />
                <TextBlock x:ConnectionId='19' x:Name="StatWf" FontSize="16" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="3" Spacing="2">
                <TextBlock Text="首杀" Style="{StaticResource HintStyle}" />
                <TextBlock x:ConnectionId='18' x:Name="StatWfPP" FontSize="16" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="通关记录" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
            <TextBlock x:ConnectionId='13' x:Name="PassesHeader" Text="" Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
            <Button x:ConnectionId='14' x:Name="MorePassesButton" Content="更多记录"                          IsEnabled="False" VerticalAlignment="Center" />
          </StackPanel>
          <Grid ColumnSpacing="8" Padding="8,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="上传时间" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="1" Text="谱面 ID" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="2" Text="曲名" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="3" Text="难度" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="4" Text="分数" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="5" Text="准确率" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="6" Text="标记" Style="{StaticResource TableHeaderStyle}" />
          </Grid>
          <ListView x:ConnectionId='3' x:Name="Passes" Height="320" ItemContainerStyle="{StaticResource CompactItemStyle}" SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate                            >
                <Grid x:ConnectionId='5' ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="150" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:ConnectionId='6' Grid.Column="0"                      Style="{StaticResource CellStyle}" />
                  <TextBlock x:ConnectionId='7' Grid.Column="1"                         Style="{StaticResource CellStyle}" />
                  <TextBlock x:ConnectionId='8' Grid.Column="2"                      Style="{StaticResource CellStyle}" />
                  <TextBlock x:ConnectionId='9' Grid.Column="3"                            Style="{StaticResource CellStyle}" />
                  <TextBlock x:ConnectionId='10' Grid.Column="4"                       Style="{StaticResource CellStyle}" />
                  <TextBlock x:ConnectionId='11' Grid.Column="5"                          Style="{StaticResource CellStyle}" />
                  <TextBlock x:ConnectionId='12' Grid.Column="6"                      Style="{StaticResource CellStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>

