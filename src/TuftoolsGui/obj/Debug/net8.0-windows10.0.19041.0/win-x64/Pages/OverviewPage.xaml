<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="TuftoolsGui.Pages.OverviewPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="24" Spacing="16">
      <TextBlock Text="概览" Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="这里配置 tuftools.exe 的路径与网络选项，其他页面都通过它调用 JSON 模式。" Style="{StaticResource HintStyle}" />
      <InfoBar x:ConnectionId='2' x:Name="StatusBar" IsOpen="False" IsClosable="True" />
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="14">
          <TextBlock Text="运行设置" Style="{StaticResource SectionTitleStyle}" />
          <Grid ColumnSpacing="8" RowSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" Text="程序路径" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:ConnectionId='4' Grid.Column="1" Grid.Row="0" x:Name="ExeBox" PlaceholderText="tuftools.exe 的完整路径" />
            <Button x:ConnectionId='5' Grid.Column="2" Grid.Row="0" Content="浏览"                      />
            <Button x:ConnectionId='6' Grid.Column="3" Grid.Row="0" Content="自动检测"                      />
            <TextBlock Grid.Column="0" Grid.Row="1" Text="代理" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:ConnectionId='7' Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" x:Name="ProxyBox" PlaceholderText="留空表示直连，例如 http://127.0.0.1:1080" />
            <TextBlock Grid.Column="0" Grid.Row="2" Text="下载目录" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:ConnectionId='8' Grid.Column="1" Grid.Row="2" x:Name="DownloadBox" PlaceholderText="谱面下载保存目录" />
            <Button x:ConnectionId='9' Grid.Column="2" Grid.Row="2" Content="浏览"                         />
            <Button x:ConnectionId='10' Grid.Column="3" Grid.Row="2" Content="打开"                       />
            <ToggleSwitch x:ConnectionId='11' Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="3" x:Name="NoCacheSwitch" Header="禁用缓存（--no-cache）" OnContent="已禁用" OffContent="使用缓存" />
            <StackPanel Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <Button x:ConnectionId='16' Content="保存设置" Style="{StaticResource AccentButtonStyle}"                    />
              <Button x:ConnectionId='17' Content="测试连接"                    />
              <ProgressRing x:ConnectionId='18' x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
            </StackPanel>
            <StackPanel Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button x:ConnectionId='12' x:Name="ImportButton" Content="导入 tuftools.exe"                      />
              <Button x:ConnectionId='13' x:Name="DownloadButton" Content="从 GitHub 下载最新版"                        />
              <HyperlinkButton Content="打开 release 页面" NavigateUri="https://github.com/SleepingCui/tuftools/releases/latest" Padding="8,4" />
              <ProgressRing x:ConnectionId='14' x:Name="InstallRing" Width="20" Height="20" IsActive="False" />
              <TextBlock x:ConnectionId='15' x:Name="InstallText" Text="" Style="{StaticResource HintStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="620" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="版本与能力" Style="{StaticResource SectionTitleStyle}" />
          <TextBlock x:ConnectionId='3' x:Name="VersionText" Text="尚未测试连接。" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="13" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="使用说明" Style="{StaticResource SectionTitleStyle}" />
          <TextBlock Style="{StaticResource HintStyle}" Text="所有请求都以 -j 方式调用 tuftools，程序通过标准输入发送 JSON 请求、读取标准输出解析响应。" />
          <TextBlock Style="{StaticResource HintStyle}" Text="访问 tuforums API 需要网络可达。若直连超时（例如报 WinHTTP 12002），请在上面填写本机代理地址。" />
          <TextBlock Style="{StaticResource HintStyle}" Text="谱面下载会把文件写入上面设置的下载目录；转换模式需要选区服预设，下载耗时取决于文件大小。" />
          <TextBlock Style="{StaticResource HintStyle}" Text="JSON 控制台可以直接发送任意请求，便于排查参数错误；响应里的 error.code 与 error.message 会原样展示。" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>

