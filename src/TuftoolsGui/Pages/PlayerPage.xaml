<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="TuftoolsGui.Pages.PlayerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:TuftoolsGui.Models">
  <Page.Resources>
    <Style x:Key="CompactItemStyle" TargetType="ListViewItem">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </Page.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="24" Spacing="16">
      <TextBlock Text="玩家查询" Style="{StaticResource PageTitleStyle}" />
      <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="搜索玩家" Style="{StaticResource SectionTitleStyle}" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="PlayerQuery" PlaceholderText="玩家 ID、名称或 Discord 用户名" KeyDown="PlayerQuery_KeyDown" />
            <ComboBox Grid.Column="1" x:Name="SearchBy" SelectedIndex="0" MinWidth="110">
              <ComboBoxItem Content="按名称或 ID" />
              <ComboBoxItem Content="按 Discord" />
            </ComboBox>
            <Button Grid.Column="2" Content="搜索" Style="{StaticResource AccentButtonStyle}" Click="Search_Click" />
            <ProgressRing Grid.Column="3" x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
          </Grid>
          <TextBlock Text="搜索结果（单击一行查看详情）" Style="{StaticResource HintStyle}" />
          <Grid ColumnSpacing="8" Padding="8,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="60" />
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ID" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="1" Text="名称" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="2" Text="国家" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="3" Text="排位分" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="4" Text="平均准确率" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="5" Text="Discord" Style="{StaticResource TableHeaderStyle}" />
          </Grid>
          <ListView x:Name="PlayerResults" Height="200" ItemContainerStyle="{StaticResource CompactItemStyle}" IsItemClickEnabled="True" ItemClick="PlayerResults_ItemClick" SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="models:PlayerRow">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="140" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{x:Bind Id}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="2" Text="{x:Bind Country}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="3" Text="{x:Bind Ranked}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="4" Text="{x:Bind Accuracy}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="5" Text="{x:Bind Discord}" Style="{StaticResource CellStyle}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="玩家详情" Style="{StaticResource SectionTitleStyle}" />
          <TextBlock x:Name="PlayerEmpty" Text="尚未选择玩家。" Style="{StaticResource HintStyle}" />
          <StackPanel x:Name="PlayerDetailPanel" Spacing="12" Visibility="Collapsed">
            <StackPanel Spacing="2">
              <TextBlock x:Name="PlayerTitle" FontSize="20" FontWeight="SemiBold" />
              <TextBlock x:Name="PlayerMeta" Style="{StaticResource HintStyle}" />
            </StackPanel>
            <Grid ColumnSpacing="8" Padding="8,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="90" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="指标" Style="{StaticResource TableHeaderStyle}" />
              <TextBlock Grid.Column="1" Text="分数" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="2" Text="全球名次" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="3" Text="国家名次" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
            </Grid>
            <ItemsControl x:Name="ScoreRows">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ScoreRow">
                  <Grid ColumnSpacing="8" Padding="8,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="140" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind Label}" Style="{StaticResource CellStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource CellStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Global}" Style="{StaticResource CellStyle}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="{x:Bind Country}" Style="{StaticResource CellStyle}" HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnSpacing="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="通关总数" Style="{StaticResource HintStyle}" />
                <TextBlock x:Name="StatPasses" FontSize="16" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="万能通关" Style="{StaticResource HintStyle}" />
                <TextBlock x:Name="StatUniversal" FontSize="16" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Text="首通" Style="{StaticResource HintStyle}" />
                <TextBlock x:Name="StatWf" FontSize="16" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Grid.Column="3" Spacing="2">
                <TextBlock Text="首杀" Style="{StaticResource HintStyle}" />
                <TextBlock x:Name="StatWfPP" FontSize="16" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="通关记录" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
            <TextBlock x:Name="PassesHeader" Text="" Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
            <Button x:Name="MorePassesButton" Content="更多记录" Click="MorePasses_Click" IsEnabled="False" VerticalAlignment="Center" />
          </StackPanel>
          <Grid ColumnSpacing="8" Padding="8,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="上传时间" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="1" Text="谱面 ID" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="2" Text="曲名" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="3" Text="难度" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="4" Text="分数" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="5" Text="准确率" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="6" Text="标记" Style="{StaticResource TableHeaderStyle}" />
          </Grid>
          <ListView x:Name="Passes" Height="320" ItemContainerStyle="{StaticResource CompactItemStyle}" SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="models:PassRow">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="150" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{x:Bind Date}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="1" Text="{x:Bind LevelId}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="2" Text="{x:Bind Song}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="3" Text="{x:Bind Difficulty}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="4" Text="{x:Bind Score}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="5" Text="{x:Bind Accuracy}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="6" Text="{x:Bind Note}" Style="{StaticResource CellStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
