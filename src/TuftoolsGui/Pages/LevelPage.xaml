<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="TuftoolsGui.Pages.LevelPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:TuftoolsGui.Models">
  <Page.Resources>
    <Style x:Key="CompactItemStyle" TargetType="ListViewItem">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </Page.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="24" Spacing="16">
      <TextBlock Text="谱面查询" Style="{StaticResource PageTitleStyle}" />
      <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="搜索谱面" Style="{StaticResource SectionTitleStyle}" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="LevelQuery" PlaceholderText="曲名、作者关键字；纯数字按谱面 ID 查询" KeyDown="LevelQuery_KeyDown" />
            <ComboBox Grid.Column="1" x:Name="SortBox" SelectedIndex="0" MinWidth="120">
              <ComboBoxItem Content="通关数" />
              <ComboBoxItem Content="下载数" />
              <ComboBoxItem Content="点赞数" />
              <ComboBoxItem Content="收藏数" />
              <ComboBoxItem Content="BPM" />
              <ComboBoxItem Content="物量" />
              <ComboBoxItem Content="时长" />
              <ComboBoxItem Content="基础分" />
              <ComboBoxItem Content="ID" />
            </ComboBox>
            <ComboBox Grid.Column="2" x:Name="OrderBox" SelectedIndex="0" MinWidth="90">
              <ComboBoxItem Content="降序" />
              <ComboBoxItem Content="升序" />
            </ComboBox>
            <TextBox Grid.Column="3" x:Name="LimitBox" Text="20" Width="70" PlaceholderText="数量" />
            <Button Grid.Column="4" Content="搜索" Style="{StaticResource AccentButtonStyle}" Click="Search_Click" />
            <ProgressRing Grid.Column="5" x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
          </Grid>
          <TextBlock Text="搜索结果（单击一行选中，再用下方按钮查看详情或 CDN）" Style="{StaticResource HintStyle}" />
          <Grid ColumnSpacing="8" Padding="8,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="ID" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="1" Text="曲名" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="2" Text="作者" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="3" Text="难度" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="4" Text="物量" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="5" Text="通关" Style="{StaticResource TableHeaderStyle}" />
            <TextBlock Grid.Column="6" Text="下载" Style="{StaticResource TableHeaderStyle}" />
          </Grid>
          <ListView x:Name="LevelResults" Height="220" ItemContainerStyle="{StaticResource CompactItemStyle}" SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="models:LevelRow">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="80" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{x:Bind Id}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Song}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="2" Text="{x:Bind Artist}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="3" Text="{x:Bind Difficulty}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="4" Text="{x:Bind Tiles}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="5" Text="{x:Bind Clears}" Style="{StaticResource CellStyle}" />
                  <TextBlock Grid.Column="6" Text="{x:Bind Downloads}" Style="{StaticResource CellStyle}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="查看详情" Click="Detail_Click" />
            <Button Content="CDN 与下载信息" Click="Cdn_Click" />
            <TextBlock x:Name="SelectedHint" Text="" Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="详情数据" Style="{StaticResource SectionTitleStyle}" />
          <ScrollViewer Height="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="DetailRows">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:KeyValueRow">
                  <Grid ColumnSpacing="8" Padding="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="260" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind Key}" Style="{StaticResource CellStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="下载谱面" Style="{StaticResource SectionTitleStyle}" />
          <Grid ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="80" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" Text="下载模式" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="0" x:Name="ModeBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ModeBox_SelectionChanged">
              <ComboBoxItem Content="原始谱面（original）" />
              <ComboBoxItem Content="转换谱面（transform）" />
              <ComboBoxItem Content="旧版 v2（v2）" />
            </ComboBox>
            <TextBlock Grid.Column="0" Grid.Row="1" Text="转换预设" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox Grid.Column="1" Grid.Row="1" x:Name="PresetBox" HorizontalAlignment="Stretch" IsEnabled="False" PlaceholderText="先读取 CDN 信息以加载预设" DisplayMemberPath="Display" />
            <TextBlock Grid.Column="2" Grid.Row="1" Text="文件名" Style="{StaticResource FieldLabelStyle}" HorizontalAlignment="Right" />
            <TextBox Grid.Column="3" Grid.Row="1" x:Name="FileNameBox" PlaceholderText="可选，留空使用曲名" />
            <StackPanel Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Content="开始下载" Style="{StaticResource AccentButtonStyle}" Click="Download_Click" />
              <Button Content="打开下载目录" Click="OpenDir_Click" />
              <ProgressRing x:Name="DownloadRing" Width="20" Height="20" IsActive="False" />
              <TextBlock x:Name="DownloadText" Text="" Style="{StaticResource HintStyle}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
